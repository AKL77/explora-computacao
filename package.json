{
  "name": "informatica-explorer",
  "private": true,
  "version": "0.1.0",
  "description": "Protótipo web para organizar recursos de Computação alinhados à BNCC e apoiar o planejamento docente.",
  "author": "Augusto Lunardi",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=11 <12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AKL77/informatica-explorer.git"
  },
  "homepage": "https://akl77.github.io/informatica-explorer/",
  "bugs": {
    "url": "https://github.com/AKL77/informatica-explorer/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "tsc --project tsconfig.json --noEmit --pretty false && vite build --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false",
    "lint": "eslint --config config/eslint.config.js .",
    "test": "vitest --config config/vitest.config.ts run",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:e2e": "playwright test --config config/playwright.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
