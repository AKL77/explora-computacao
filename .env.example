# ID público do projeto. O padrão já é o projeto do Explora Computação.
# Defina outro ID para trocar de projeto, ou deixe vazio para desativar a análise.
# O Clarity permanece desativado durante pnpm dev.
VITE_CLARITY_PROJECT_ID=z4honwtjtg

# demo: dados locais, para desenvolvimento e testes. supabase: contas e dados online.
VITE_APP_MODE=demo
# Use apenas a URL e a chave PUBLICÁVEL. Nunca uma chave secreta/service_role no Vite.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
